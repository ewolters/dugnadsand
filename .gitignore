*.py[cod]

# Generated by collectstatic — rebuilt on every deploy.
staticfiles/

logs/
*.log

# Secrets live in the deployment environment, never in the tree.
.env
*.sqlite3

# Uploaded photographs. Content, not code — and not web-served: /media/ is
# routed nowhere and every photo is delivered by a view that checks access.
media/
